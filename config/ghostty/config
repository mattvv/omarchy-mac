# Omarchy-flavored Ghostty — Solitude theme
# Based on omarchy config/ghostty/config, minus Linux-only options
# (gtk-toolbar-style, async-backend=epoll, window-theme=ghostty).

# ── Theme (generated by bin/theme.py) ────────────────────────────────────────
# `?` makes the include optional, the same way omarchy's own ghostty config
# points at its current-theme file.
config-file = ?"~/.config/ghostty/theme.conf"
# Written by font.sh when a font is chosen from the menu. Later includes win, so
# this overrides the font-family below without that line being edited.
config-file = ?"~/.config/ghostty/font.conf"

# ── Font (Hack Nerd Font — user preference over Omarchy default) ─────────────
# JetBrainsMono, not Hack: starship's jetpack preset uses seven plain-Unicode
# symbols (⌂ ✕ ⋈ ⌽ ⌾ ℂ ✶) that Hack Nerd Font does not carry, so they rendered
# as tofu. JetBrainsMono covers all seven, and every menu icon besides.
font-family = "JetBrainsMono NFM"
font-style = Regular
font-size = 16

# ── Window (Omarchy padding, macOS titlebar) ─────────────────────────────────
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
macos-titlebar-style = hidden
# `hidden` drops the titlebar but keeps the window frame, which reads as a grey
# outline around every Ghostty window while WezTerm -- which sets
# window_decorations = 'RESIZE' -- has none. `none` removes the frame too, so
# the two terminals look like each other and like Omarchy, where nothing wears
# a border but the one JankyBorders draws.
window-decoration = none
background-opacity = 0.9
confirm-close-surface = false
resize-overlay = never

# ── Cursor (Omarchy) ──────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env

# ── Keybindings (from Omarchy) ───────────────────────────────────────────────
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u

# Ghostty owns this hotkey itself. AeroSpace cannot open a new Ghostty window
# (no macOS CLI for it: `+new-window` is Linux-only, `open -na` spawns a second
# instance, and AppleScript keystroke needs an Automation grant it can't prompt
# for from a background exec). A global: keybind sidesteps all of that.
keybind = global:alt+enter=new_window

# ── Misc (Omarchy) ────────────────────────────────────────────────────────────
mouse-scroll-multiplier = 0.95
copy-on-select = clipboard
