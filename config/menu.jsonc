// Omarchy menu definition, macOS edition.
//
// Same schema as upstream's default/omarchy/omarchy-menu.jsonc: ids are object
// keys, a dotted id implies hierarchy (style.theme belongs under style), and the
// kind is inferred -- an "action" runs, anything else is a submenu.
//
// Optional fields:
//   aliases   alternate names, also searchable
//   when      shell condition; the row is hidden when it fails
//   checked   shell condition; the row gets a check when it succeeds
//
// Only entries whose actions actually work on macOS live here. The rest of
// upstream's 340 are tracked in dev-notes/menu-plan.md, including the ones that
// have no honest equivalent and are not coming.
{
  // ── Root ──────────────────────────────────────────────────────────────────
  "style":  {"icon":"", "label":"Style",  "aliases":["appearance"]},
  "learn":  {"icon":"󰧑", "label":"Learn"},
  "system": {"icon":"", "label":"System", "aliases":["power"]},

  // ── Style ─────────────────────────────────────────────────────────────────
  "style.theme":      {"icon":"󰸌", "label":"Theme",      "aliases":["theme","themes"],
                       "action":"$OMARCHY_BIN/theme_menu.sh"},
  "style.background": {"icon":"", "label":"Background", "aliases":["wallpaper"],
                       "action":"$OMARCHY_BIN/bg_menu.sh"},
  "style.background-next": {"icon":"󰒭", "label":"Next Background",
                       "action":"python3 $OMARCHY_BIN/theme.py bg next"},
  "style.bar":        {"icon":"󰍜", "label":"Menu Bar"},
  "style.bar.toggle": {"icon":"󰔌", "label":"Toggle",
                       "action":"sketchybar --bar hidden=toggle"},

  // ── Learn ─────────────────────────────────────────────────────────────────
  "learn.omarchy":     {"icon":"", "label":"Omarchy",
                        "action":"open https://omarchy.org"},
  "learn.aerospace":   {"icon":"", "label":"AeroSpace",
                        "action":"open https://nikitabobko.github.io/AeroSpace/guide"},

  // ── System ────────────────────────────────────────────────────────────────
  // Upstream has hibernate too; Apple Silicon has no hibernate, so it is absent
  // rather than pretending.
  "system.screensaver": {"icon":"󱄄", "label":"Screensaver",
                         "action":"open -a ScreenSaverEngine"},
  // CGSession was the classic lock; it is gone in macOS 15 (Menu Extras still
  // exists as a directory but no longer contains it), which the action test
  // caught. Sleeping the display locks whenever "require password after sleep"
  // is set, which is the default.
  "system.lock":        {"icon":"", "label":"Lock",
                         "action":"pmset displaysleepnow"},
  "system.suspend":     {"icon":"󰒲", "label":"Suspend", "aliases":["sleep"],
                         "action":"pmset sleepnow"},
  "system.logout":      {"icon":"󰍃", "label":"Logout",
                         "action":"osascript -e 'tell application \"System Events\" to log out'"},
  "system.reboot":      {"icon":"󰜉", "label":"Reboot", "aliases":["restart"],
                         "action":"osascript -e 'tell application \"System Events\" to restart'"},
  "system.shutdown":    {"icon":"⏻", "label":"Shutdown",
                         "action":"osascript -e 'tell application \"System Events\" to shut down'"},
}
