// Omarchy menu definition, macOS edition.
//
// Same schema as upstream's default/omarchy/omarchy-menu.jsonc: ids are object
// keys, a dotted id implies hierarchy (style.theme belongs under style), and the
// kind is inferred -- an "action" runs, anything else is a submenu.
//
// Optional fields:
//   aliases   alternate names, also searchable
//   when      shell condition; the row is hidden when it fails
//   checked   shell condition; the row gets a check when it succeeds
//
// Only entries whose actions actually work on macOS live here. The rest of
// upstream's 340 are tracked in dev-notes/menu-plan.md, including the ones that
// have no honest equivalent and are not coming.
{
  // ── Root ──────────────────────────────────────────────────────────────────
  "style":  {"icon":"", "label":"Style",  "aliases":["appearance"]},
  "trigger":{"icon":"󱓞", "label":"Trigger", "aliases":["capture","screenshot"]},
  "setup":  {"icon":"", "label":"Setup", "aliases":["settings","config"]},
  "update": {"icon":"", "label":"Update", "aliases":["upgrade"]},
  "install":{"icon":"󰉉", "label":"Install", "aliases":["add","brew"]},
  "learn":  {"icon":"󰧑", "label":"Learn"},
  "system": {"icon":"", "label":"System", "aliases":["power"]},

  // ── Style ─────────────────────────────────────────────────────────────────
  "style.theme":      {"icon":"󰸌", "label":"Theme",      "aliases":["theme","themes"],
                       "action":"$OMARCHY_BIN/theme_menu.sh"},
  "style.background": {"icon":"", "label":"Background", "aliases":["wallpaper"],
                       "action":"$OMARCHY_BIN/bg_menu.sh"},
  "style.background-next": {"icon":"󰒭", "label":"Next Background",
                       "action":"python3 $OMARCHY_BIN/theme.py bg next"},
  "style.font":       {"icon":"", "label":"Font", "aliases":["typeface"], "provider":"fonts"},
  "style.bar":        {"icon":"󰍜", "label":"Menu Bar"},
  "style.bar.toggle": {"icon":"󰔌", "label":"Toggle",
                       "action":"sketchybar --bar hidden=toggle"},

  // ── Trigger ───────────────────────────────────────────────────────────────
  // Upstream's Trigger group is 46 entries. These are the ones macOS can
  // actually do without a dependency we do not already have; the rest are
  // listed in dev-notes/menu-plan.md rather than given a row that does nothing.
  "trigger.screenshot": {"icon":"󰹑", "label":"Screenshot (region)", "aliases":["capture","screen"],
                         "action":"screencapture -i \"$HOME/Desktop/Screenshot $(date '+%Y-%m-%d at %H.%M.%S').png\""},
  "trigger.screenshot-window": {"icon":"󰖯", "label":"Screenshot (window)",
                         "action":"screencapture -iW \"$HOME/Desktop/Screenshot $(date '+%Y-%m-%d at %H.%M.%S').png\""},
  "trigger.screenrecord": {"icon":"󰕧", "label":"Screen recording", "aliases":["record","video"],
                         "action":"screencapture -v \"$HOME/Desktop/Recording $(date '+%Y-%m-%d at %H.%M.%S').mov\""},
  "trigger.color": {"icon":"󰸌", "label":"Colour picker", "aliases":["color","pick"],
                         "action":"open -a \"Digital Color Meter\""},
  // `checked` puts a tick on the row when the assertion is up, so the menu says
  // which way the toggle currently sits instead of making you remember.
  "trigger.stay-awake": {"icon":"󰅶", "label":"Stay awake", "aliases":["caffeinate","insomnia"],
                         "checked":"$OMARCHY_BIN/stay_awake.sh status",
                         "action":"$OMARCHY_BIN/stay_awake.sh toggle"},

  // ── Setup ─────────────────────────────────────────────────────────────────
  // Upstream scripts these outright because Linux lets it. macOS puts most of
  // them behind System Settings with no supported CLI, so the honest
  // equivalent is to open the exact pane rather than pretend to set it.
  "setup.keybindings": {"icon":"", "label":"Edit keybindings", "aliases":["aerospace","config"],
                        "action":"open -t \"$HOME/.aerospace.toml\""},
  "setup.config":      {"icon":"", "label":"Edit config"},
  "setup.config.ghostty":    {"icon":"", "label":"Ghostty",
                        "action":"open -t \"$HOME/.config/ghostty/config\""},
  "setup.config.sketchybar": {"icon":"󰍜", "label":"Bar",
                        "action":"open -t \"$HOME/.config/sketchybar/sketchybarrc\""},
  "setup.config.menu":       {"icon":"", "label":"This menu",
                        "action":"open -t \"$HOME/.local/share/omarchy-mac/menu.jsonc\""},
  "setup.monitors":    {"icon":"󰍹", "label":"Displays", "aliases":["monitor","screen"],
                        "action":"open x-apple.systempreferences:com.apple.Displays-Settings.extension"},
  "setup.input":       {"icon":"", "label":"Keyboard", "aliases":["input","repeat"],
                        "action":"open x-apple.systempreferences:com.apple.Keyboard-Settings.extension"},
  "setup.trackpad":    {"icon":"󰟸", "label":"Trackpad",
                        "action":"open x-apple.systempreferences:com.apple.Trackpad-Settings.extension"},
  "setup.dns":         {"icon":"󰖟", "label":"DNS", "aliases":["network","resolver"]},
  "setup.dns.dhcp":       {"icon":"󰑓", "label":"DHCP (automatic)",
                        "checked":"$OMARCHY_BIN/dns.sh status | grep -q DHCP",
                        "action":"$OMARCHY_BIN/dns.sh dhcp"},
  "setup.dns.cloudflare": {"icon":"󰅟", "label":"Cloudflare  1.1.1.1",
                        "checked":"$OMARCHY_BIN/dns.sh status | grep -q 1.1.1.1",
                        "action":"$OMARCHY_BIN/dns.sh cloudflare"},
  "setup.dns.google":     {"icon":"󰊭", "label":"Google  8.8.8.8",
                        "checked":"$OMARCHY_BIN/dns.sh status | grep -q 8.8.8.8",
                        "action":"$OMARCHY_BIN/dns.sh google"},
  "setup.dns.quad9":      {"icon":"󰒃", "label":"Quad9  9.9.9.9",
                        "checked":"$OMARCHY_BIN/dns.sh status | grep -q 9.9.9.9",
                        "action":"$OMARCHY_BIN/dns.sh quad9"},

  "style.bar.position":     {"icon":"", "label":"Position"},
  "style.bar.position.top": {"icon":"󰁝", "label":"Top",
                             "checked":"$OMARCHY_BIN/bar.sh is-position top",
                             "action":"$OMARCHY_BIN/bar.sh top"},
  "style.bar.position.bottom": {"icon":"󰁅", "label":"Bottom",
                             "checked":"$OMARCHY_BIN/bar.sh is-position bottom",
                             "action":"$OMARCHY_BIN/bar.sh bottom"},
  "style.bar.transparency": {"icon":"󰂵", "label":"Transparency"},
  "style.bar.transparency.solid": {"icon":"󰂵", "label":"Solid",
                             "checked":"$OMARCHY_BIN/bar.sh is-alpha ff",
                             "action":"$OMARCHY_BIN/bar.sh solid"},
  "style.bar.transparency.translucent": {"icon":"󰂵", "label":"Translucent",
                             "checked":"$OMARCHY_BIN/bar.sh is-alpha cc",
                             "action":"$OMARCHY_BIN/bar.sh translucent"},
  "style.bar.transparency.transparent": {"icon":"󰂵", "label":"Transparent",
                             "checked":"$OMARCHY_BIN/bar.sh is-alpha 66",
                             "action":"$OMARCHY_BIN/bar.sh transparent"},

  // ── Update ────────────────────────────────────────────────────────────────
  // Upstream updates Omarchy itself and re-lays its configs. Same here, from
  // whichever checkout install.sh ran from -- recorded at install time rather
  // than guessed.
  "update.omarchy":  {"icon":"•", "label":"Update omarchy-mac", "aliases":["upgrade","pull"],
                       "action":"$OMARCHY_BIN/update.sh omarchy"},
  "update.config":   {"icon":"", "label":"Reinstall config"},
  "update.config.aerospace":  {"icon":"", "label":"AeroSpace",
                       "action":"$OMARCHY_BIN/update.sh config aerospace"},
  "update.config.ghostty":    {"icon":"", "label":"Ghostty",
                       "action":"$OMARCHY_BIN/update.sh config ghostty"},
  "update.config.wezterm":    {"icon":"", "label":"WezTerm",
                       "action":"$OMARCHY_BIN/update.sh config wezterm"},
  "update.config.sketchybar": {"icon":"󰍜", "label":"Bar",
                       "action":"$OMARCHY_BIN/update.sh config sketchybar"},
  "update.config.menu":       {"icon":"", "label":"Menu",
                       "action":"$OMARCHY_BIN/update.sh config menu"},
  // systemsetup -settimezone needs root, so this opens the pane instead of
  // pretending to set it.
  "update.time":     {"icon":"", "label":"Date & Time", "aliases":["timezone","clock"],
                       "action":"open x-apple.systempreferences:com.apple.Date-Time-Settings.extension"},

  // ── Install ───────────────────────────────────────────────────────────────
  // Upstream's install group is 91 entries of pacman and AUR. Almost none of it
  // has a macOS counterpart; what does is a cask, and the fonts are the part
  // that matters here because the menu offers only fonts you already have.
  // A tick means the family is already on the machine -- read from the font
  // files rather than asking brew, which would be six subprocesses per open.
  "install.font": {"icon":"", "label":"Install font"},
  "install.font.cascadia": {"icon":"", "label":"Cascadia Mono",
                          "checked":"$OMARCHY_BIN/fonts.py has Caskaydia",
                          "action":"/Applications/Ghostty.app/Contents/MacOS/ghostty -e /bin/bash -lc 'brew install --cask font-caskaydia-mono-nerd-font; echo; echo Press return to close.; read -r _'"},
  "install.font.meslo": {"icon":"", "label":"Meslo LG",
                          "checked":"$OMARCHY_BIN/fonts.py has MesloLG",
                          "action":"/Applications/Ghostty.app/Contents/MacOS/ghostty -e /bin/bash -lc 'brew install --cask font-meslo-lg-nerd-font; echo; echo Press return to close.; read -r _'"},
  "install.font.fira": {"icon":"", "label":"Fira Code",
                          "checked":"$OMARCHY_BIN/fonts.py has FiraCode",
                          "action":"/Applications/Ghostty.app/Contents/MacOS/ghostty -e /bin/bash -lc 'brew install --cask font-fira-code-nerd-font; echo; echo Press return to close.; read -r _'"},
  "install.font.victor": {"icon":"", "label":"Victor Mono",
                          "checked":"$OMARCHY_BIN/fonts.py has VictorMono",
                          "action":"/Applications/Ghostty.app/Contents/MacOS/ghostty -e /bin/bash -lc 'brew install --cask font-victor-mono-nerd-font; echo; echo Press return to close.; read -r _'"},
  "install.font.bitstream": {"icon":"", "label":"Bitstream Vera Mono",
                          "checked":"$OMARCHY_BIN/fonts.py has Bitstrom",
                          "action":"/Applications/Ghostty.app/Contents/MacOS/ghostty -e /bin/bash -lc 'brew install --cask font-bitstream-vera-sans-mono-nerd-font; echo; echo Press return to close.; read -r _'"},
  "install.font.iosevka": {"icon":"", "label":"Iosevka",
                          "checked":"$OMARCHY_BIN/fonts.py has Iosevka",
                          "action":"/Applications/Ghostty.app/Contents/MacOS/ghostty -e /bin/bash -lc 'brew install --cask font-iosevka-nerd-font; echo; echo Press return to close.; read -r _'"},

  // ── Learn ─────────────────────────────────────────────────────────────────
  "learn.keybindings": {"icon":"", "label":"Keybindings", "aliases":["keys","bindings"],
                        "action":"$OMARCHY_BIN/keybindings_menu.sh"},
  "learn.omarchy":     {"icon":"", "label":"Omarchy",
                        "action":"open https://omarchy.org"},
  "learn.aerospace":   {"icon":"", "label":"AeroSpace",
                        "action":"open https://nikitabobko.github.io/AeroSpace/guide"},

  // ── System ────────────────────────────────────────────────────────────────
  // Upstream has hibernate too; Apple Silicon has no hibernate, so it is absent
  // rather than pretending.
  "system.screensaver": {"icon":"󱄄", "label":"Screensaver",
                         "action":"open -a ScreenSaverEngine"},
  // CGSession was the classic lock; it is gone in macOS 15 (Menu Extras still
  // exists as a directory but no longer contains it), which the action test
  // caught. Sleeping the display locks whenever "require password after sleep"
  // is set, which is the default.
  "system.lock":        {"icon":"", "label":"Lock",
                         "action":"pmset displaysleepnow"},
  "system.suspend":     {"icon":"󰒲", "label":"Suspend", "aliases":["sleep"],
                         "action":"pmset sleepnow"},
  "system.logout":      {"icon":"󰍃", "label":"Logout",
                         "action":"osascript -e 'tell application \"System Events\" to log out'"},
  "system.reboot":      {"icon":"󰜉", "label":"Reboot", "aliases":["restart"],
                         "action":"osascript -e 'tell application \"System Events\" to restart'"},
  "system.shutdown":    {"icon":"⏻", "label":"Shutdown",
                         "action":"osascript -e 'tell application \"System Events\" to shut down'"},
}
